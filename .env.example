# ─── Application ───────────────────────────────────────────
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ─── Database ──────────────────────────────────────────────
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/majhi_vastu?schema=public

# ─── Auth.js ───────────────────────────────────────────────
AUTH_SECRET=your-auth-secret-change-in-production
AUTH_URL=http://localhost:3000

# ─── Admin Credentials (for seeding) ──────────────────────
ADMIN_EMAIL=admin@majivastu.com
ADMIN_PASSWORD=change-this-in-production

# ─── Cloudinary ────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# ─── VAPID (Web Push) ─────────────────────────────────────────────────────
NEXT_PUBLIC_VAPID_PUBLIC_KEY=your-vapid-public-key
VAPID_PRIVATE_KEY=your-vapid-private-key
VAPID_SUBJECT=mailto:admin@mazivastu.com

# ─── WhatsApp ─────────────────────────────────────────────
WHATSAPP_ADMIN_NUMBER=919876543210

# ─── Rate Limiting ────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100
